# Copy this file to .env and fill in your own keys. Never commit .env.

# --- Anam (avatar face + voice) ---
ANAM_API_KEY=your-anam-api-key
ANAM_API_BASE=https://api.anam.ai
ANAM_API_URL=https://api.anam.ai
ANAM_AVATAR_ID=98ba35ae-5ecb-41dc-9d54-009e9fc6acf2

# --- Claude (the LLM doing the thinking) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-5
# Set to "true" to let Claude use its web_search tool for live/internet questions
# (e.g. "what's the weather in Singapore right now") when local files don't answer it.
ENABLE_WEB_SEARCH=true

# --- Local knowledge ---
# Comma-separated absolute folders to scan for context (filenames + small text files).
# On Windows, point these at real drive letters, e.g.:
#   LOCAL_KNOWLEDGE_PATHS=Y:\,Z:\,C:\Users\you\Documents,D:\
# WARNING: scanning entire C:\ or D:\ drives sends file/folder names (and contents of
# small text files) to Anthropic's API as context. That's a lot of personal data going
# to a third party for a demo. Prefer pointing at specific project/document folders
# instead of whole drive roots. Depth and file-count are capped below regardless.
LOCAL_KNOWLEDGE_PATHS=
LOCAL_KNOWLEDGE_MAX_DEPTH=3
LOCAL_KNOWLEDGE_MAX_FILES=500

PORT=3000
